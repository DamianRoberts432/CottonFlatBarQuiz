[Unit]
Description=Cotton Flat Bar Quiz (Quiz.py)
Requires=cotton-flat-quiz-update.service
After=network-online.target cotton-flat-quiz-update.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=d
WorkingDirectory=/home/d/CottonFlatBarQuiz
ExecStartPre=/usr/bin/test -f /home/d/CottonFlatBarQuiz/Quiz.py
ExecStartPre=/usr/bin/python3 -m py_compile /home/d/CottonFlatBarQuiz/Quiz.py
ExecStart=/usr/bin/python3 /home/d/CottonFlatBarQuiz/Quiz.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONFAULTHANDLER=1
Environment=PORTAL_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
