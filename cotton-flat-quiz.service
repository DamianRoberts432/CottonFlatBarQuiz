[Unit]
Description=Cotton Flat Bar Quiz (Quiz.py)
Requires=cotton-flat-quiz-update.service
After=cotton-flat-quiz-update.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=d
WorkingDirectory=/home/d/CottonFlatBarQuiz
ExecStart=/usr/bin/python3 /home/d/CottonFlatBarQuiz/Quiz.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
