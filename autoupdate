
#!/usr/bin/env bash
set -e

REPO_DIR="/home/pi/CottonFlatBarQuiz"
LOG_FILE="/home/pi/CottonFlatBarQuiz/boot.log"

cd "$REPO_DIR"

echo "===== BOOT $(date) =====" >> "$LOG_FILE"

# Sync latest code
git fetch --all >> "$LOG_FILE" 2>&1
git reset --hard origin/main >> "$LOG_FILE" 2>&1

# Optional: Python deps
python3 -m pip install -r requirements.txt >> "$LOG_FILE" 2>&1 || true

# Run your quiz app
exec /usr/bin/python3 "/home/pi/Desktop/Quiz.py" >> "$LOG_FILE" 2>&1
