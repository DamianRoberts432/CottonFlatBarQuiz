# -------------------------
# DB Helpers
# -------------------------
def db_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = db_conn()
    c = conn.cursor()

    c.execute("""
    CREATE TABLE IF NOT EXISTS questions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        text TEXT NOT NULL,
        is_open_text INTEGER NOT NULL DEFAULT 1,
        op1 TEXT DEFAULT '',
        op2 TEXT DEFAULT '',
        op3 TEXT DEFAULT '',
        op4 TEXT DEFAULT '',
        approved INTEGER NOT NULL DEFAULT 1,
        created_at TEXT NOT NULL
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS votes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        question_id INTEGER NOT NULL,
        choice INTEGER NOT NULL,
        created_at TEXT NOT NULL,
        FOREIGN KEY(question_id) REFERENCES questions(id)
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS text_responses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        question_id INTEGER NOT NULL,
        author TEXT NOT NULL DEFAULT 'Anonymous',
        message TEXT NOT NULL,
        created_at TEXT NOT NULL,
        FOREIGN KEY(question_id) REFERENCES questions(id)
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS suggestions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        text TEXT NOT NULL,
        is_open_text INTEGER NOT NULL,
        op1 TEXT DEFAULT '',
        op2 TEXT DEFAULT '',
        op3 TEXT DEFAULT '',
        op4 TEXT DEFAULT '',
        created_at TEXT NOT NULL
    )
    """)

    # Seed with a few starter prompts if empty
    count = c.execute("SELECT COUNT(*) AS n FROM questions WHERE approved=1").fetchone()["n"]
    if count == 0:
        seed_questions = [
            ("If your unedited web search history from the past year was put on a billboard, what would require the longest explanation?", 1, "", "", "", ""),
            ("You make accidental eye contact with a stranger on a crowded subway. What is your automatic behavioral coping mechanism?", 0,
             "Look down and scroll on your phone.",
             "Smile awkwardly and look away.",
             "Double down and stare back aggressively.",
             "Pretend you didn't even notice."),
            ("What is the most socially acceptable lie that everyone tells almost daily?", 1, "", "", "", ""),
            ("You hear your own voice on a recorded audio message. What is your reaction?", 0,
             "Absolute disgust and instant denial.",
             "Acceptance, I sound completely normal.",
             "Confusion, that cannot be what I sound like.",
             "Never listening to a voice note ever again.")
        ]
        for q in seed_questions:
            c.execute("""
                INSERT INTO questions (text, is_open_text, op1, op2, op3, op4, approved, created_at)
                VALUES (?, ?, ?, ?, ?, ?, 1, ?)
            """, (*q, datetime.utcnow().isoformat()))

    conn.commit()
    conn.close()

