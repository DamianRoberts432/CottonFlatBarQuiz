@app.route("/submit-answer", methods=["POST"])
def submit_answer():
    qid = session.get("current_qid")
    if not qid:
        return redirect(url_for("quiz"))

    conn = db_conn()
    q = conn.execute("SELECT * FROM questions WHERE id=?", (qid,)).fetchone()

    if not q:
        conn.close()
        return redirect(url_for("quiz"))

    if q["is_open_text"] == 1:
        msg = (request.form.get("text_choice") or "").strip()
        if msg:
            anonymous_checked = request.form.get("post_anonymously") is not None
            raw_author = (request.form.get("author") or "").strip()
            author = "Anonymous" if anonymous_checked or not raw_author else raw_author
            conn.execute("""
                INSERT INTO text_responses (question_id, author, message, created_at)
                VALUES (?, ?, ?, ?)
            """, (qid, author, msg, datetime.utcnow().isoformat()))
            conn.commit()

        rows = conn.execute("""
            SELECT author, message, created_at FROM text_responses
            WHERE question_id=?
            ORDER BY id DESC
            LIMIT 50
        """, (qid,)).fetchall()

        content = "<h2>What others wrote</h2>"
        if not rows:
            content += "<p>No responses yet.</p>"
        else:
            for r in rows:
                content += f"<div class='resp left'><b>{r['author']}:</b> {r['message']}</div>"

    else:
        choice = request.form.get("num_choice")
        if choice in {"1", "2", "3", "4"}:
            conn.execute("""
                INSERT INTO votes (question_id, choice, created_at)
                VALUES (?, ?, ?)
            """, (qid, int(choice), datetime.utcnow().isoformat()))
            conn.commit()

        counts = {1:0,2:0,3:0,4:0}
        rows = conn.execute("SELECT choice, COUNT(*) AS n FROM votes WHERE question_id=? GROUP BY choice", (qid,)).fetchall()
        for r in rows:
            counts[r["choice"]] = r["n"]
        total = sum(counts.values()) or 1

        content = "<h2>Current distribution</h2><div class='left'>"
        for i in [1,2,3,4]:
            op = q[f"op{i}"]
            n = counts[i]
            pct = int((n*100)/total)
            content += f"<p><b>{op}</b> — {n} votes ({pct}%)</p>"
        content += "</div>"

    conn.close()
    content += "<a class='btn' href='/quiz'>Next Question</a><a class='btn btn-sec' href='/'>Main Menu</a>"
    return page("Results", content)

@app.route("/answers")
def answers():
    conn = db_conn()
    rows = conn.execute("""
        SELECT tr.id, tr.author, tr.message, tr.created_at, q.text
        FROM text_responses tr
        JOIN questions q ON q.id = tr.question_id
        ORDER BY tr.id DESC
        LIMIT 200
    """).fetchall()
    conn.close()

    body = "<h2>Public Answers Feed</h2>"
    if not rows:
        body += "<p>No answers yet.</p>"
    else:
        for r in rows:
            body += f"""
            <div class='resp left'>
                <small><b>Prompt:</b> {r['text']}</small><br>
                <b>{r['author']}:</b> {r['message']}
            </div>
            """
    body += "<a class='btn btn-sec' href='/'>Back</a>"
    return page("Answers", body)

@app.route("/submit-question", methods=["GET", "POST"])
def submit_question():
    if request.method == "GET":
        body = """
        <h2>Submit a Question</h2>
        <form method='post'>
            <input name='qtext' placeholder='Question text...' required>
            <select name='qtype' id='qtype' onchange='toggleOps()'>
                <option value='text'>Open Text</option>
                <option value='mc'>Multiple Choice</option>
            </select>
            <div id='ops' style='display:none'>
                <input name='op1' placeholder='Option 1'>
                <input name='op2' placeholder='Option 2'>
                <input name='op3' placeholder='Option 3'>
                <input name='op4' placeholder='Option 4'>
            </div>
            <button class='btn btn-ok' type='submit'>Send for Review</button>
        </form>
        <a class='btn btn-sec' href='/'>Back</a>
        <script>
        function toggleOps(){
            const v=document.getElementById('qtype').value;
            document.getElementById('ops').style.display = (v==='mc')?'block':'none';
        }
        </script>
        """
        return page("Submit Question", body)

    qtext = (request.form.get("qtext") or "").strip()
    qtype = request.form.get("qtype", "text")
    is_open = 0 if qtype == "mc" else 1
    op1 = request.form.get("op1", "")
    op2 = request.form.get("op2", "")
    op3 = request.form.get("op3", "")
    op4 = request.form.get("op4", "")

    if not qtext:
        return page("Error", "<h3>Question text required.</h3><a class='btn' href='/submit-question'>Back</a>")

    conn = db_conn()
    conn.execute("""
        INSERT INTO suggestions (text, is_open_text, op1, op2, op3, op4, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?)
    """, (qtext, is_open, op1, op2, op3, op4, datetime.utcnow().isoformat()))
    conn.commit()
    conn.close()

    return page("Submitted", "<h3>Sent for admin review.</h3><a class='btn' href='/'>Main Menu</a>")

