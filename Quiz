        return page("No Questions", "<h2>No approved questions yet.</h2><a class='btn' href='/'>Back</a>")

    q = rows[0]
    session["current_qid"] = q["id"]

    if q["is_open_text"] == 1:
        body = f"""
        <h2>Prompt</h2>
        <p><b>{q['text']}</b></p>
        <form method='post' action='/submit-answer'>
            <input name='author' placeholder='Your name (optional)'>
            <label class='left'><input type='checkbox' name='post_anonymously' value='1' checked> Post anonymously</label>
            <textarea name='text_choice' rows='4' placeholder='Type response...' required></textarea>
            <button class='btn' type='submit'>Submit Response</button>
        </form>
        <a class='btn btn-sec' href='/'>Back</a>
        """
    else:
        body = f"""
        <h2>Prompt</h2>
        <p><b>{q['text']}</b></p>
        <form method='post' action='/submit-answer'>
            <button class='btn' type='submit' name='num_choice' value='1'>{q['op1']}</button>
            <button class='btn' type='submit' name='num_choice' value='2'>{q['op2']}</button>
