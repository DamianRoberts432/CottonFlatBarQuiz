@app.route("/admin/responses")
def admin_responses():
    if not admin_required():
        return redirect(url_for("admin"))

    conn = db_conn()
    rows = conn.execute("""
        SELECT tr.id, tr.author, tr.message, tr.created_at, q.text
        FROM text_responses tr
        JOIN questions q ON q.id = tr.question_id
        ORDER BY tr.id DESC
        LIMIT 300
    """).fetchall()
    conn.close()

    body = "<h2>Delete Bad Answers</h2>"
    if not rows:
        body += "<p>No responses yet.</p>"
    else:
        for r in rows:
            body += f"""
            <div class='resp left'>
                <small><b>Prompt:</b> {r['text']}</small><br>
                <b>{r['author']}:</b> {r['message']}<br>
                <a class='btn btn-del' href='/admin/delete-response/{r["id"]}' onclick="return confirm('Delete this answer?')">Delete Immediately</a>
