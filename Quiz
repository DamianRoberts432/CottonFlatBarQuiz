@app.route("/")
def home():
    return INDEX_HTML

@app.route("/get_question")
def get_question():
    target_id = int(request.args.get("id", 0))
    for q in question_database[target_id:]:
        if q["status"] == 0:
            return jsonify({"id": q["id"], "text": q["text"], "choices": q["choices"]})
    return jsonify({"error": True})

@app.route("/submit")
def submit():
    q_id = int(request.args.get("id", 0))
    choice = int(request.args.get("choice", 0))
    if 0 <= q_id < len(question_database) and 0 <= choice < 3:
        question_database[q_id]["votes"][choice] += 1
    return jsonify({"votes": question_database[q_id]["votes"]})

@app.route("/suggest")
def suggest():
    new_id = len(question_database)
    question_database.append({
        "id": new_id,
        "text": request.args.get("text"),
        "choices": [request.args.get("c0"), request.args.get("c1"), request.args.get("c2")],
        "votes":,
        "status": 1
    })
    return "OK"
@app.route("/admin_login")
def admin_login():
    return jsonify({"success": request.args.get("pin") == ADMIN_PIN})

@app.route("/admin_get_limbo")
def admin_get_limbo():
    if request.args.get("pin") != ADMIN_PIN: return "Denied", 403
    for q in question_database:
        if q["status"] == 1:
            return jsonify({"id": q["id"], "text": q["text"], "choices": q["choices"]})
    return jsonify({"id": -1})

@app.route("/admin_mod")
def admin_mod():
    if request.args.get("pin") != ADMIN_PIN: return "Denied", 403
    q_id = int(request.args.get("id"))
    status = int(request.args.get("status"))
    question_database[q_id]["status"] = status
    return "OK"

@app.route("/admin_clear_stats")
def admin_clear_stats():
    if request.args.get("pin") != ADMIN_PIN: return "Denied", 403
    for q in question_database:
        q["votes"] = [0, 0, 0]
    return "OK"

def handle_serial_input():
    try:
        ser = serial.Serial('/dev/ttyUSB0', 115200, timeout=1)
        while True:
            line = ser.readline().decode('utf-8').strip()
            if line.startswith("SUBMIT:"):
                parts = line.split(":")
                q_id, choice = int(parts[1]), int(parts[2])
                if 0 <= q_id < len(question_database) and 0 <= choice < 3:
                    question_database[q_id]["votes"][choice] += 1
    except Exception as e:
        pass

if __name__ == "__main__":
    threading.Thread(target=handle_serial_input, daemon=True).start()
    app.run(host="0.0.0.0", port=5000)
