[Unit]
Description=Update Cotton Flat Bar Quiz from GitHub (via Cotton Flat Bar Quiz portal)
Wants=network-online.target
After=network-online.target
Before=cotton-flat-quiz.service

[Service]
Type=oneshot
User=d
WorkingDirectory=/home/d/CottonFlatBarQuiz
ExecStart=/usr/bin/env bash -lc 'cd /home/d/CottonFlatBarQuiz && bash ./update-quiz.sh || true'
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
